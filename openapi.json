{
  "openapi": "3.0.0",
  "paths": {
    "/uploader": {
      "post": {
        "operationId": "UploaderController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAssetDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid asset metadata"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      },
      "get": {
        "operationId": "UploaderController_findAll",
        "parameters": [
          {
            "name": "archived",
            "required": false,
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssetDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      }
    },
    "/uploader/upload": {
      "post": {
        "operationId": "UploaderController_upload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Browser image or video, or PDF (image/*, video/*, or application/pdf)"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "File persisted in Spaces and asset metadata saved as READY",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "File is missing, empty, too large, not a browser image/video or PDF, or metadata is invalid"
          },
          "401": {
            "description": "Authentication required"
          },
          "503": {
            "description": "Spaces upload failed; caller must upload the file again"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "summary": "Persist a file in Spaces and record its asset metadata",
        "tags": [
          "uploader"
        ]
      }
    },
    "/uploader/{id}": {
      "get": {
        "operationId": "UploaderController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed asset ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Asset not found"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      },
      "patch": {
        "operationId": "UploaderController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAssetDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID or invalid metadata"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Asset not found"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      },
      "delete": {
        "operationId": "UploaderController_remove",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "Malformed asset ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Asset not found"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      }
    },
    "/uploader/{id}/archive": {
      "patch": {
        "operationId": "UploaderController_archive",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed asset ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Asset not found"
          }
        },
        "security": [
          {
            "accessToken": []
          },
          {
            "bearer": []
          }
        ],
        "tags": [
          "uploader"
        ]
      }
    },
    "/uploader/{id}/unarchive": {
      "patch": {
        "operationId": "UploaderController_unarchive",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetDto"
                }
              }
            }
          },
          "400": {
            "description": "Malformed asset ID"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Asset not found"
