  },
  "info": {
    "title": "NGX service-uploader API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "accessToken"
      }
    },
    "schemas": {
      "CreateAssetDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "tags": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "AssetDto": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean"
          },
          "version": {
            "type": "number"
          },
          "storageStatus": {
            "type": "string",
            "enum": [
              "AWAITING_UPLOAD",
              "PENDING_STORAGE",
              "READY",
              "STORAGE_FAILED"
            ]
          },
          "storageKey": {
            "type": "string",
            "description": "Server-generated Spaces object key"
          },
          "storageUrl": {
            "type": "string",
            "description": "Spaces origin URL; read access depends on object permissions"
          },
          "originalFilename": {
            "type": "string",
            "description": "Sanitized and normalized original upload filename"
          },
          "mediaType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "number"
          },
          "checksumSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "SHA-256 digest of the received file"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "name",
          "tags",
          "archived",
          "version",
          "storageStatus",
          "createdAt",
          "updatedAt"
        ]
      },
      "UpdateAssetDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "tags": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "archived": {
            "type": "boolean"
          }
        }
      }
    }
  }
}