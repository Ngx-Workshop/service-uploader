# Include within the gateway's existing server block after reviewing the upstream.
# Test with nginx -t before reloading. This file is not installed automatically.
location ~ ^/api/uploader(/|$) {
    rewrite ^/api(/.*)$ $1 break;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_pass http://SERVICE_PRIVATE_HOST:3010;
}
